# JPMorgan Financial APIs - Production Environment Configuration
# LIVE PRODUCTION DEPLOYMENT

# ============================================================================
# CORE APPLICATION SETTINGS
# ============================================================================

SECRET_KEY=prod-jpmorgan-2024-secure-key-change-this-immediately
FLASK_ENV=production
FLASK_DEBUG=False
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DATABASE_URL=postgresql://jpmorgan_prod:SecureP@ssw0rd2024@localhost:5432/jpmorgan_financial_apis_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
CACHE_DEFAULT_TTL=300
CACHE_TELEMETRY_TTL=60

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

JWT_SECRET_KEY=jwt-prod-secret-2024-change-immediately
JWT_REFRESH_SECRET_KEY=jwt-refresh-prod-secret-2024-change-immediately
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

TOKEN_CLIENT_ID=jpmorgan-prod-client-id
TOKEN_CLIENT_SECRET=jpmorgan-prod-client-secret-change-this
TOKEN_ENDPOINT=https://api.jpmorgan.com/oauth/token

RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

CORS_ORIGINS=https://api.jpmorgan-prod.com,https://app.jpmorgan-prod.com
CORS_ALLOW_CREDENTIALS=True

# ============================================================================
# CLOUD STORAGE CONFIGURATION
# ============================================================================

AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=jpmorgan-telemetry-prod

# ============================================================================
# GPU CONFIGURATION
# ============================================================================

CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8
TF_FORCE_GPU_ALLOW_GROWTH=True
USE_GPU=True
GPU_DEVICE_ID=0

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
APM_ENABLED=True
APM_SERVICE_NAME=jpmorgan-financial-apis-prod
APM_SERVER_URL=http://localhost:8200

LOG_FORMAT=json
LOG_FILE=/var/log/jpmorgan/production.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ============================================================================
# EXTERNAL API INTEGRATIONS
# ============================================================================

GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_OWNER=your-org
GITHUB_REPO=jpmorgan-financial-apis
ALLOW_MISSING_TOKENS=False

# ============================================================================
# MACHINE LEARNING CONFIGURATION
# ============================================================================

ML_MODEL_PATH=/app/models
ML_BATCH_SIZE=32
ML_INFERENCE_TIMEOUT=30
ANOMALY_THRESHOLD=0.95
ANOMALY_WINDOW_SIZE=100

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

WEBSOCKET_ENABLED=True
WEBSOCKET_PING_INTERVAL=25
WEBSOCKET_PING_TIMEOUT=60
WEBSOCKET_MAX_CONNECTIONS=1000

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_ML_ENABLED=True
FEATURE_GPU_ACCELERATION=True
FEATURE_CLOUD_STORAGE=True
FEATURE_WEBSOCKET=True
FEATURE_ADVANCED_ANALYTICS=True

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

WORKERS=4
WORKER_CLASS=gevent
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=120
REQUEST_TIMEOUT=60
MAX_CONTENT_LENGTH=16777216

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

SSL_CERT_PATH=/etc/ssl/jpmorgan/server.crt
SSL_KEY_PATH=/etc/ssl/jpmorgan/server.key
FORCE_HTTPS=True
HTTPS_REDIRECT=True

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================

AUDIT_LOG_ENABLED=True
AUDIT_LOG_PATH=/var/log/jpmorgan/audit.log
DATA_RETENTION_DAYS=90
LOG_RETENTION_DAYS=365
GDPR_ENABLED=True
DATA_ANONYMIZATION=True

# ============================================================================
# KUBERNETES SPECIFIC
# ============================================================================

K8S_NAMESPACE=jpmorgan-prod
K8S_SERVICE_NAME=jpmorgan-api
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

# ============================================================================
# ADDITIONAL SETTINGS
# ============================================================================

TZ=UTC
APP_VERSION=1.0.0
MAINTENANCE_MODE=False
DEBUG=False
