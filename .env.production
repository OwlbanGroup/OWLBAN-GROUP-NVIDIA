# JPMorgan Financial APIs - Production Environment (Dev/Localhost Mode)
# Copy to .env.production and customize for real production

# Database
DB_PASSWORD=secure_password_123

# App Secrets (CHANGE THESE for production!)
SECRET_KEY=your-super-secret-key-change-me-in-production-123456
JWT_SECRET_KEY=jwt-super-secret-key-change-me-in-production-789

# Grafana
GRAFANA_PASSWORD=admin

# SSL/Certbot (localhost dev - uses staging or skip)
SSL_EMAIL=admin@example.com
DOMAIN=localhost

# Dev mode
DEV_MODE=true

