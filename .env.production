# FastAPI Configuration
ENVIRONMENT=production
SECRET_KEY=your-production-secret-key-change-this
HOST=0.0.0.0
PORT=8000

# ASGI Server Configuration (Uvicorn)
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
ACCESS_LOG=true

# Database Configuration
DATABASE_URL=postgresql://jpmorgan_prod:secure_password_123@localhost:5432/jpmorgan_prod
DATABASE_TYPE=postgresql

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JP Morgan API Configuration
JPMORGAN_CLIENT_ID=your-prod-client-id
JPMORGAN_CLIENT_SECRET=your-prod-client-secret
JPMORGAN_ENVIRONMENT=prod

# Security Configuration
ALLOWED_ORIGINS=https://localhost:8000,https://api.localhost:8000
AUDIT_LOG_ENABLED=true
RATE_LIMIT_DEFAULT=100 per hour

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
