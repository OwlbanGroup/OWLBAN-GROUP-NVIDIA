# ============================================
# JPMorgan Financial APIs - QAF Environment
# ============================================
# Copy this file to .env.qaf and fill in your actual credentials
# NEVER commit .env.qaf to version control!

# Environment Selection
JPMORGAN_ENVIRONMENT=qaf

# ============================================
# OpenBanking API - QAF (uses production)
# ============================================
JPMORGAN_OPENBANKING_PRODUCTION_URL=https://openbanking.jpmorgan.com/accessapi
JPMORGAN_OPENBANKING_CLIENT_ID=your_qaf_openbanking_client_id_here
JPMORGAN_OPENBANKING_CLIENT_SECRET=your_qaf_openbanking_client_secret_here
JPMORGAN_OPENBANKING_API_KEY=your_qaf_openbanking_api_key_here

# ============================================
# API Gateway - QAF
# ============================================
JPMORGAN_APIGATEWAY_QAF_URL=https://apigatewayqaf.jpmorgan.com/accessapi
JPMORGAN_APIGATEWAY_CLIENT_ID=your_qaf_apigateway_client_id_here
JPMORGAN_APIGATEWAY_CLIENT_SECRET=your_qaf_apigateway_client_secret_here
JPMORGAN_APIGATEWAY_API_KEY=your_qaf_apigateway_api_key_here

# ============================================
# Legacy JPMorgan API Settings (if needed)
# ============================================
JPMORGAN_BASE_URL=https://api-qaf.payments.jpmorgan.com
JPMORGAN_AUTH_URL=https://auth-qaf.payments.jpmorgan.com

# AI Accounts Project (QAF)
JPMORGAN_AI_ACCOUNTS_CLIENT_ID=your_qaf_ai_accounts_client_id_here
JPMORGAN_AI_ACCOUNTS_CLIENT_SECRET=your_qaf_ai_accounts_client_secret_here
JPMORGAN_AI_ACCOUNTS_API_KEY=your_qaf_ai_accounts_api_key_here

# Corporate Login Project (QAF)
JPMORGAN_CORPORATE_CLIENT_ID=your_qaf_corporate_client_id_here
JPMORGAN_CORPORATE_CLIENT_SECRET=your_qaf_corporate_client_secret_here
JPMORGAN_CORPORATE_API_KEY=your_qaf_corporate_api_key_here

# Payroll Project (QAF)
JPMORGAN_PAYROLL_CLIENT_ID=your_qaf_payroll_client_id_here
JPMORGAN_PAYROLL_CLIENT_SECRET=your_qaf_payroll_client_secret_here
JPMORGAN_PAYROLL_API_KEY=your_qaf_payroll_api_key_here

# Petty Cash Project (QAF)
JPMORGAN_PETTY_CASH_CLIENT_ID=your_qaf_petty_cash_client_id_here
JPMORGAN_PETTY_CASH_CLIENT_SECRET=your_qaf_petty_cash_client_secret_here
JPMORGAN_PETTY_CASH_API_KEY=your_qaf_petty_cash_api_key_here

# Owl1 Integration Project (QAF)
JPMORGAN_OWL1_CLIENT_ID=your_qaf_owl1_client_id_here
JPMORGAN_OWL1_CLIENT_SECRET=your_qaf_owl1_client_secret_here
JPMORGAN_OWL1_API_KEY=your_qaf_owl1_api_key_here

# ============================================
# Application Settings
# ============================================
API_BASE_URL=https://api-qaf.jpmorgan.com
API_VERSION=v1
LOG_LEVEL=DEBUG
LOG_FILE=logs/telemetry_qaf.log

# Security
SECRET_KEY=your_qaf_secret_key_here_minimum_32_characters

# Token Management
TOKEN_CLIENT_ID=your_qaf_token_client_id_here
TOKEN_CLIENT_SECRET=your_qaf_token_client_secret_here
TOKEN_URL=https://id-qaf.payments.jpmorgan.com/am/oauth2/alpha/access_token
TOKEN_SCOPE=openid profile

# Database (QAF)
DATABASE_TYPE=postgresql
DATABASE_HOST=your_qaf_db_host
DATABASE_PORT=5432
DATABASE_NAME=jpmorgan_financial_apis_qaf
DATABASE_USER=your_qaf_db_user
DATABASE_PASSWORD=your_qaf_db_password
DATABASE_SSL_MODE=require

# Redis (QAF)
REDIS_URL=redis://your_qaf_redis_host:6379/0

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# Flask
FLASK_ENV=development
FLASK_RUN_PORT=5002
TESTING=0

# ============================================
# QAF Environment Notes
# ============================================
# 1. QAF is for Quality Assurance and Functional Testing
# 2. Use test data only - no real customer information
# 3. QAF credentials are separate from production and UAT
# 4. Perform comprehensive testing including edge cases
# 5. Test API Gateway functionality thoroughly
# 6. Document all test cases and results
# 7. Verify integration with all downstream systems
