# JPMorgan Financial APIs - Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# ============================================================================
# API Settings
# ============================================================================
API_BASE_URL=https://api.jpmorgan.com
API_VERSION=v1
FLASK_RUN_PORT=8000
FLASK_ENV=production

# ============================================================================
# Security Settings (REQUIRED - Generate secure values)
# ============================================================================
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# ============================================================================
# Database Settings (PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://jpmorgan_prod:SecureP%40ssw0rd2024@postgresql:5432/jpmorgan_financial_apis_prod
DATABASE_TYPE=postgresql
DATABASE_HOST=postgresql
DATABASE_PORT=5432
DATABASE_NAME=jpmorgan_financial_apis_prod
DATABASE_USER=jpmorgan_prod
DATABASE_PASSWORD=SecureP@ssw0rd2024
DATABASE_SSL_MODE=prefer
DATABASE_CONNECTION_POOL_SIZE=10
DATABASE_CONNECTION_POOL_MAX_OVERFLOW=20
DATABASE_CONNECTION_POOL_TIMEOUT=30
DATABASE_CONNECTION_POOL_RECYCLE=3600

# ============================================================================
# Redis Cache Settings
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Logging Settings
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/jpmorgan/telemetry.log

# ============================================================================
# Telemetry Settings
# ============================================================================
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# ============================================================================
# Token Management (Optional - for JPMorgan OAuth2)
# ============================================================================
TOKEN_CLIENT_ID=your_client_id_here
TOKEN_CLIENT_SECRET=your_client_secret_here
TOKEN_URL=https://id.payments.jpmorgan.com/am/oauth2/alpha/access_token
TOKEN_SCOPE=openid profile
ALLOW_MISSING_TOKENS=true

# ============================================================================
# GitHub MCP Server (Optional)
# ============================================================================
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
MCP_SERVER_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
MCP_SERVER_TOOLSETS=all
MCP_SERVER_HOST=

# ============================================================================
# Cloud Storage (Optional)
# ============================================================================
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=jpmorgan-telemetry-prod
AWS_REGION=us-east-1

# Google Cloud Storage
GCS_PROJECT_ID=your_gcs_project_id
GCS_BUCKET=jpmorgan-telemetry-prod
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
AZURE_CONTAINER_NAME=jpmorgan-telemetry-prod

# ============================================================================
# GPU Settings (Optional - for ML features)
# ============================================================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8

# NGC (NVIDIA GPU Cloud)
NGC_API_KEY=your_ngc_api_key
NGC_CLI_PATH=ngc
NGC_REGISTRY_URL=nvcr.io
NGC_ORG=nvidia

# ============================================================================
# Monitoring & Alerting
# ============================================================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
ALERTMANAGER_ENABLED=true

# ============================================================================
# Application Settings
# ============================================================================
WORKERS=4
WORKER_CLASS=sync
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=30
KEEPALIVE=5
