# Environment variables for JPMorgan Financial APIs
# Replace with actual values

# Required: Token management credentials
TOKEN_CLIENT_ID=your_token_client_id_here
TOKEN_CLIENT_SECRET=your_token_client_secret_here

# Required: Flask app secret key for session security
SECRET_KEY=your_flask_secret_key_here

# Optional: API settings
API_BASE_URL=https://api.jpmorgan.com
API_VERSION=v1

# Optional: Logging settings
LOG_LEVEL=INFO
LOG_FILE=logs/telemetry.log

# Optional: Telemetry settings
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# Optional: Database settings
DATABASE_URL=sqlite:///telemetry.db

# Optional: Token URL
TOKEN_URL=https://id.payments.jpmorgan.com/am/oauth2/alpha/access_token
TOKEN_SCOPE=openid profile

# Optional: MCP Server settings
MCP_SERVER_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
MCP_SERVER_TOOLSETS=all
MCP_SERVER_HOST=

# Optional: Redis URL (if using Redis)
REDIS_URL=
