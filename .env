# Production Environment Variables for JPMorgan Financial APIs

# Environment
JPMORGAN_ENVIRONMENT=prod
FLASK_ENV=production
TESTING=0

# Database
DATABASE_URL=sqlite:///jpmorgan_api.db
DATABASE_TYPE=sqlite

# Security
SECRET_KEY=your-production-secret-key-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/telemetry.log

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_ALERT_ENABLED=true
AUDIT_FAILED_LOGIN_THRESHOLD=5
AUDIT_RATE_LIMIT_THRESHOLD=100
AUDIT_BRUTE_FORCE_THRESHOLD=10
AUDIT_SUSPICIOUS_IP_THRESHOLD=5
AUDIT_ALERT_NOTIFICATION_METHOD=log
AUDIT_CLEANUP_ENABLED=true
AUDIT_HASH_CHAIN_ENABLED=true

# CORS
ALLOWED_ORIGINS=https://api.equityshieldadvocates.com,https://dashboard.equityshieldadvocates.com

# API Credentials (Replace with actual values)
# JPMORGAN_OPENBANKING_CLIENT_ID=your-client-id
# JPMORGAN_OPENBANKING_CLIENT_SECRET=your-client-secret
# JPMORGAN_OPENBANKING_API_KEY=your-api-key
# JPMORGAN_APIGATEWAY_CLIENT_ID=your-client-id
# JPMORGAN_APIGATEWAY_CLIENT_SECRET=your-client-secret
# JPMORGAN_APIGATEWAY_API_KEY=your-api-key
# TOKEN_CLIENT_ID=your-token-client-id
# TOKEN_CLIENT_SECRET=your-token-client-secret
