# JPMorgan Financial APIs Environment Configuration
# Basic development/testing configuration

# Flask Settings
FLASK_ENV=development
FLASK_RUN_PORT=5000
TESTING=1

# Security Settings
SECRET_KEY=dev_secret_key_for_testing_only
ALLOW_MISSING_TOKENS=true

# Database Settings (SQLite for development)
DATABASE_URL=sqlite:///telemetry.db
DATABASE_TYPE=sqlite

# Redis Settings (optional for development)
REDIS_URL=redis://localhost:6379/0

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/telemetry.log

# Telemetry Settings
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# Audit Logging Settings
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_ALERT_ENABLED=true
AUDIT_FAILED_LOGIN_THRESHOLD=5

# Token Management (dummy values for testing)
TOKEN_CLIENT_ID=dummy_client_id
TOKEN_CLIENT_SECRET=dummy_client_secret
TOKEN_URL=https://dummy.token.url
TOKEN_SCOPE=dummy_scope

# JPMorgan API Settings (dummy for testing)
JPMORGAN_ENVIRONMENT=uat
JPMORGAN_OPENBANKING_CLIENT_ID=dummy
JPMORGAN_OPENBANKING_CLIENT_SECRET=dummy
JPMORGAN_APIGATEWAY_CLIENT_ID=dummy
JPMORGAN_APIGATEWAY_CLIENT_SECRET=dummy

# GitHub MCP Settings (optional)
GITHUB_PERSONAL_ACCESS_TOKEN=dummy_token

# GPU Settings (optional)
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8
