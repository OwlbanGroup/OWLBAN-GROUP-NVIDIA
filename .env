# .env.example - Copy this file to .env and replace placeholders with actual values
# Required for OAuth Authentication (JPMorgan)
TOKEN_CLIENT_ID=your_jpmorgan_client_id_here
TOKEN_CLIENT_SECRET=your_jpmorgan_client_secret_here

# Required for Session Security
SECRET_KEY=generate_a_secure_key_here  # Use: python -c "import secrets; print(secrets.token_hex(32))"

# Required for GitHub MCP Integration
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# Redis for Caching and Pub/Sub (default: localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database URL (SQLite default; change for PostgreSQL, etc.)
DATABASE_URL=sqlite:///telemetry.db

# Optional: Token Endpoint and Scope
TOKEN_URL=https://id.payments.jpmorgan.com/am/oauth2/alpha/access_token
TOKEN_SCOPE=openid profile

# Optional: MCP Server Configuration
MCP_SERVER_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
MCP_SERVER_TOOLSETS=all
MCP_SERVER_HOST=

# Optional: API Settings
API_BASE_URL=https://api.jpmorgan.com
API_VERSION=v1

# Optional: Telemetry Settings
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# Optional: Log File Path
LOG_FILE=logs/telemetry.log
