# ============================================
# JPMorgan Financial APIs - UAT Environment
# ============================================
# Copy this file to .env.uat and fill in your actual credentials
# NEVER commit .env.uat to version control!

# Environment Selection
JPMORGAN_ENVIRONMENT=uat

# ============================================
# OpenBanking API - UAT
# ============================================
JPMORGAN_OPENBANKING_UAT_URL=https://openbankinguat.jpmorgan.com/accessapi
JPMORGAN_OPENBANKING_CLIENT_ID=your_uat_openbanking_client_id_here
JPMORGAN_OPENBANKING_CLIENT_SECRET=your_uat_openbanking_client_secret_here
JPMORGAN_OPENBANKING_API_KEY=your_uat_openbanking_api_key_here

# ============================================
# API Gateway - UAT (uses production gateway)
# ============================================
JPMORGAN_APIGATEWAY_PRODUCTION_URL=https://apigateway.jpmorgan.com/accessapi
JPMORGAN_APIGATEWAY_CLIENT_ID=your_uat_apigateway_client_id_here
JPMORGAN_APIGATEWAY_CLIENT_SECRET=your_uat_apigateway_client_secret_here
JPMORGAN_APIGATEWAY_API_KEY=your_uat_apigateway_api_key_here

# ============================================
# Legacy JPMorgan API Settings (if needed)
# ============================================
JPMORGAN_BASE_URL=https://api-uat.payments.jpmorgan.com
JPMORGAN_AUTH_URL=https://auth-uat.payments.jpmorgan.com

# AI Accounts Project (UAT)
JPMORGAN_AI_ACCOUNTS_CLIENT_ID=your_uat_ai_accounts_client_id_here
JPMORGAN_AI_ACCOUNTS_CLIENT_SECRET=your_uat_ai_accounts_client_secret_here
JPMORGAN_AI_ACCOUNTS_API_KEY=your_uat_ai_accounts_api_key_here

# Corporate Login Project (UAT)
JPMORGAN_CORPORATE_CLIENT_ID=your_uat_corporate_client_id_here
JPMORGAN_CORPORATE_CLIENT_SECRET=your_uat_corporate_client_secret_here
JPMORGAN_CORPORATE_API_KEY=your_uat_corporate_api_key_here

# Payroll Project (UAT)
JPMORGAN_PAYROLL_CLIENT_ID=your_uat_payroll_client_id_here
JPMORGAN_PAYROLL_CLIENT_SECRET=your_uat_payroll_client_secret_here
JPMORGAN_PAYROLL_API_KEY=your_uat_payroll_api_key_here

# Petty Cash Project (UAT)
JPMORGAN_PETTY_CASH_CLIENT_ID=your_uat_petty_cash_client_id_here
JPMORGAN_PETTY_CASH_CLIENT_SECRET=your_uat_petty_cash_client_secret_here
JPMORGAN_PETTY_CASH_API_KEY=your_uat_petty_cash_api_key_here

# Owl1 Integration Project (UAT)
JPMORGAN_OWL1_CLIENT_ID=your_uat_owl1_client_id_here
JPMORGAN_OWL1_CLIENT_SECRET=your_uat_owl1_client_secret_here
JPMORGAN_OWL1_API_KEY=your_uat_owl1_api_key_here

# ============================================
# Application Settings
# ============================================
API_BASE_URL=https://api-uat.jpmorgan.com
API_VERSION=v1
LOG_LEVEL=DEBUG
LOG_FILE=logs/telemetry_uat.log

# Security
SECRET_KEY=your_uat_secret_key_here_minimum_32_characters

# Token Management
TOKEN_CLIENT_ID=your_uat_token_client_id_here
TOKEN_CLIENT_SECRET=your_uat_token_client_secret_here
TOKEN_URL=https://id-uat.payments.jpmorgan.com/am/oauth2/alpha/access_token
TOKEN_SCOPE=openid profile

# Database (UAT)
DATABASE_TYPE=postgresql
DATABASE_HOST=your_uat_db_host
DATABASE_PORT=5432
DATABASE_NAME=jpmorgan_financial_apis_uat
DATABASE_USER=your_uat_db_user
DATABASE_PASSWORD=your_uat_db_password
DATABASE_SSL_MODE=require

# Redis (UAT)
REDIS_URL=redis://your_uat_redis_host:6379/0

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# Flask
FLASK_ENV=development
FLASK_RUN_PORT=5001
TESTING=0

# ============================================
# UAT Environment Notes
# ============================================
# 1. UAT is for User Acceptance Testing
# 2. Use test data only - no real customer information
# 3. UAT credentials are separate from production
# 4. Test all features before promoting to production
# 5. Monitor logs for errors and warnings
# 6. Document all test scenarios and results
