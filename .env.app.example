# Copy to .env.production and supply unique, securely generated values.
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_USERNAME=owlban_service
API_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ORIGINS=https://app.example.com
APP_API_KEYS={}
APP_DB_PATH=/data/owlban_app.db
RATE_LIMIT_PER_MINUTE=60
