{
  "dashboard": {
    "title": "JPMorgan Live Transaction Dashboard",
    "tags": ["jpmorgan", "payments", "transactions", "production"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    },
    "panels": [
      {
        "id": 1,
        "title": "💰 Total Payments Today",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(payment_created_total{period=\"today\"})",
            "legendFormat": "Total Payments"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 100, "color": "yellow" },
                { "value": 500, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      },
      {
        "id": 2,
        "title": "💵 Total Amount Processed Today",
        "type": "stat",
        "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(payment_amount_cents_total{period=\"today\"}) / 100",
            "legendFormat": "Total Amount"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 1000000, "color": "yellow" },
                { "value": 10000000, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 3,
        "title": "✅ Success Rate",
        "type": "stat",
        "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(payment_completed_total) / sum(payment_created_total)) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 95, "color": "yellow" },
                { "value": 99, "color": "green" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 4,
        "title": "⏱️ Avg Processing Time",
        "type": "stat",
        "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "avg(payment_processing_duration_seconds)",
            "legendFormat": "Avg Time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 2,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 2, "color": "yellow" },
                { "value": 5, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 5,
        "title": "📊 Payment Status Overview",
        "type": "piechart",
        "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (status) (payment_status_total)",
            "legendFormat": "{{status}}"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          },
          "pieType": "donut",
          "tooltip": { "mode": "single" }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "COMPLETED" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "FAILED" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "PENDING_APPROVAL" },
              "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "SUBMITTED" },
              "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
            }
          ]
        }
      },
      {
        "id": 6,
        "title": "🔄 Pending Approvals",
        "type": "stat",
        "gridPos": { "x": 0, "y": 4, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(payment_status_total{status=\"PENDING_APPROVAL\"})",
            "legendFormat": "Pending"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 10, "color": "yellow" },
                { "value": 50, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 7,
        "title": "🚀 In-Flight Payments",
        "type": "stat",
        "gridPos": { "x": 4, "y": 4, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(payment_status_total{status=\"SUBMITTED\"})",
            "legendFormat": "In-Flight"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": { "mode": "palette-classic" }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 8,
        "title": "✅ Completed Today",
        "type": "stat",
        "gridPos": { "x": 8, "y": 4, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(payment_completed_total{period=\"today\"})",
            "legendFormat": "Completed"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": { "mode": "fixed", "fixedColor": "green" }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 9,
        "title": "❌ Failed Today",
        "type": "stat",
        "gridPos": { "x": 12, "y": 4, "w": 4, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(payment_failed_total{period=\"today\"})",
            "legendFormat": "Failed"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 10, "color": "red" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 10,
        "title": "📈 Payment Volume by Rail (24h)",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (type) (rate(payment_created_total[5m]))",
            "legendFormat": "{{type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": { "mode": "normal" }
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "ACH" },
              "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "WIRE" },
              "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "RTP" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
            }
          ]
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "calcs": ["last", "max", "mean"]
          }
        }
      },
      {
        "id": 11,
        "title": "💰 Payment Amount by Rail (24h)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (type) (rate(payment_amount_cents_total[5m])) / 100",
            "legendFormat": "{{type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": { "mode": "normal" }
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "calcs": ["last", "max", "mean"]
          }
        }
      },
      {
        "id": 12,
        "title": "⏱️ Approval Metrics",
        "type": "stat",
        "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "avg(approval_duration_seconds)",
            "legendFormat": "Avg Approval Time"
          },
          {
            "refId": "B",
            "expr": "sum(approval_rejected_total) / sum(approval_total) * 100",
            "legendFormat": "Rejection Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 2
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Rejection Rate" },
              "properties": [
                { "id": "unit", "value": "percent" },
                { "id": "color", "value": { "mode": "thresholds" } },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      { "value": null, "color": "green" },
                      { "value": 5, "color": "yellow" },
                      { "value": 10, "color": "red" }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 13,
        "title": "🚨 Limit Monitoring",
        "type": "bargauge",
        "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum by (limit_type) (limit_usage_cents) / sum by (limit_type) (limit_threshold_cents)) * 100",
            "legendFormat": "{{limit_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 1,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "green" },
                { "value": 70, "color": "yellow" },
                { "value": 90, "color": "red" }
              ]
            },
            "max": 100,
            "min": 0
          }
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        }
      },
      {
        "id": 14,
        "title": "🏥 JPMorgan API Health",
        "type": "stat",
        "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "(sum(jpmorgan_api_requests_total{status=\"success\"}) / sum(jpmorgan_api_requests_total)) * 100",
            "legendFormat": "Success Rate"
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum(rate(jpmorgan_api_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 95, "color": "yellow" },
                { "value": 99, "color": "green" }
              ]
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "P95 Latency" },
              "properties": [
                { "id": "unit", "value": "s" },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      { "value": null, "color": "green" },
                      { "value": 0.5, "color": "yellow" },
                      { "value": 1, "color": "red" }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 15,
        "title": "🔑 Token Refresh Status",
        "type": "stat",
        "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(jpmorgan_token_refresh_success_total) / sum(jpmorgan_token_refresh_total) * 100",
            "legendFormat": "Success Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 95, "color": "yellow" },
                { "value": 99, "color": "green" }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 16,
        "title": "📋 Live Transaction Feed",
        "type": "table",
        "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "topk(20, payment_events{event_type=\"payment_created\"})",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "amount_cents" },
              "properties": [
                { "id": "unit", "value": "currencyUSD" },
                { "id": "decimals", "value": 2 },
                { "id": "custom.displayMode", "value": "color-background" }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "status" },
              "properties": [
                { "id": "custom.displayMode", "value": "color-background" },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "COMPLETED": { "color": "green", "text": "✅ Completed" },
                        "FAILED": { "color": "red", "text": "❌ Failed" },
                        "PENDING_APPROVAL": { "color": "yellow", "text": "🔄 Pending" },
                        "SUBMITTED": { "color": "blue", "text": "🚀 Submitted" }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [{ "displayName": "timestamp", "desc": true }]
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "job": true, "instance": true },
              "indexByName": {
                "timestamp": 0,
                "payment_id": 1,
                "type": 2,
                "amount_cents": 3,
                "status": 4,
                "external_reference": 5
              },
              "renameByName": {
                "timestamp": "Time",
                "payment_id": "Payment ID",
                "type": "Rail",
                "amount_cents": "Amount",
                "status": "Status",
                "external_reference": "Reference"
              }
            }
          }
        ]
      },
      {
        "id": 17,
        "title": "💵 Cash Position",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(account_available_balance_cents) / 100",
            "legendFormat": "Available Balance"
          },
          {
            "refId": "B",
            "expr": "sum(account_ledger_balance_cents) / 100",
            "legendFormat": "Ledger Balance"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "calcs": ["last", "min", "max"]
          }
        }
      },
      {
        "id": 18,
        "title": "⚠️ Risk & Compliance Alerts",
        "type": "table",
        "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "payment_high_value_total{amount_cents>10000000}",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "alert_type" },
              "properties": [
                { "id": "custom.displayMode", "value": "color-background" },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "HIGH_VALUE": { "color": "orange", "text": "💰 High Value" },
                        "DUAL_APPROVAL": { "color": "yellow", "text": "✋ Dual Approval" },
                        "LIMIT_BREACH": { "color": "red", "text": "🚨 Limit Breach" },
                        "SUSPICIOUS": { "color": "red", "text": "⚠️ Suspicious" }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [{ "displayName": "timestamp", "desc": true }]
        }
      },
      {
        "id": 19,
        "title": "📊 Performance Metrics",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "histogram_quantile(0.50, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P50 Processing Time"
          },
          {
            "refId": "B",
            "expr": "histogram_quantile(0.95, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95 Processing Time"
          },
          {
            "refId": "C",
            "expr": "histogram_quantile(0.99, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P99 Processing Time"
          },
          {
            "refId": "D",
            "expr": "avg(webhook_processing_duration_seconds)",
            "legendFormat": "Webhook Processing"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 0,
              "showPoints": "auto"
            }
          }
        },
        "options": {
          "tooltip": { "mode": "multi" },
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "showLegend": true,
            "calcs": ["last", "mean", "max"]
          }
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "deployment_timestamp",
          "iconColor": "blue",
          "tagKeys": "version"
        },
        {
