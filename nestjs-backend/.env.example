# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=jpmorgan_financial_db
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=30000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=1h

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# CORS Configuration
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# JPMorgan API Configuration (if applicable)
JPMORGAN_API_KEY=your_api_key_here
JPMORGAN_API_SECRET=your_api_secret_here
JPMORGAN_BASE_URL=https://api.jpmorgan.com
