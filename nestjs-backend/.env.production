# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# JP MORGAN LIVE TRANSACTION SYSTEM
# ============================================
# CRITICAL: Never commit this file to version control
# Use Azure Key Vault or AWS Secrets Manager in production
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
PORT=3000
APP_NAME=JPMorgan Payment System
APP_VERSION=1.0.0

# ============================================
# DATABASE CONFIGURATION (Production)
# ============================================
DATABASE_HOST=prod-jpmorgan-db.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=jpmorgan_payments_prod
DATABASE_USERNAME=jpmorgan_app_user
DATABASE_PASSWORD=${VAULT_DB_PASSWORD}
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50
DATABASE_CONNECTION_TIMEOUT=30000

# ============================================
# JP MORGAN PRODUCTION API CONFIGURATION
# ============================================
JPM_ENV=production
JPM_PROD_ENABLED=true

# OAuth2 Configuration
JPM_PROD_CLIENT_ID=${VAULT_JPM_CLIENT_ID}
JPM_PROD_CLIENT_SECRET=${VAULT_JPM_CLIENT_SECRET}
JPM_PROD_TOKEN_URL=https://api.jpmorgan.com/oauth2/access_token
JPM_PROD_SCOPES=payments:read payments:write ach:originate wire:send rtp:send

# API Endpoints
JPM_PROD_BASE_URL=https://api.jpmorgan.com/v1
JPM_PROD_ACCOUNTS_URL=https://api.jpmorgan.com/v1/accounts
JPM_PROD_BALANCES_URL=https://api.jpmorgan.com/v1/balances
JPM_PROD_TRANSACTIONS_URL=https://api.jpmorgan.com/v1/transactions
JPM_PROD_ACH_URL=https://api.jpmorgan.com/v1/ach
JPM_PROD_WIRE_URL=https://api.jpmorgan.com/v1/wire
JPM_PROD_RTP_URL=https://api.jpmorgan.com/v1/rtp

# Webhook Configuration
JPM_PROD_WEBHOOK_URL=https://your-domain.com/api/webhooks/jpmorgan
JPM_PROD_WEBHOOK_SECRET=${VAULT_JPM_WEBHOOK_SECRET}

# ============================================
# MTLS CONFIGURATION (Mutual TLS)
# ============================================
MTLS_ENABLED=true
MTLS_CERT_PATH=/app/certs/production/client-cert.pem
MTLS_KEY_PATH=/app/certs/production/client-key.pem
MTLS_CA_PATH=/app/certs/production/ca-cert.pem
MTLS_PASSPHRASE=${VAULT_MTLS_PASSPHRASE}

# ============================================
# HMAC REQUEST SIGNING
# ============================================
HMAC_ENABLED=true
HMAC_SECRET=${VAULT_HMAC_SECRET}
HMAC_ALGORITHM=sha256
HMAC_HEADER_NAME=X-JPM-Signature

# ============================================
# SECURITY CONFIGURATION
# ============================================

# API Key Authentication
API_KEY_ADMIN=${VAULT_API_KEY_ADMIN}
API_KEY_MAKER=${VAULT_API_KEY_MAKER}
API_KEY_CHECKER=${VAULT_API_KEY_CHECKER}
API_KEY_VIEWER=${VAULT_API_KEY_VIEWER}

# IP Allowlisting (comma-separated)
ALLOWED_IPS=10.0.1.0/24,10.0.2.0/24,52.168.0.0/16
IP_ALLOWLIST_ENABLED=true

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGIN=https://your-frontend-domain.com,https://admin.your-domain.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# AZURE KEY VAULT CONFIGURATION
# ============================================
AZURE_KEY_VAULT_ENABLED=true
AZURE_KEY_VAULT_URL=https://jpmorgan-prod-kv.vault.azure.net/
AZURE_TENANT_ID=${AZURE_TENANT_ID}
AZURE_CLIENT_ID=${AZURE_CLIENT_ID}
AZURE_CLIENT_SECRET=${AZURE_CLIENT_SECRET}

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# Grafana
GRAFANA_URL=https://grafana.your-domain.com
GRAFANA_API_KEY=${VAULT_GRAFANA_API_KEY}

# Application Insights (Azure)
APPINSIGHTS_ENABLED=true
APPINSIGHTS_INSTRUMENTATION_KEY=${VAULT_APPINSIGHTS_KEY}
APPINSIGHTS_CONNECTION_STRING=${VAULT_APPINSIGHTS_CONNECTION}

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=file,console,azure
LOG_FILE_PATH=/var/log/jpmorgan-payments/app.log
LOG_MAX_FILES=30
LOG_MAX_SIZE=100m

# ============================================
# ALERTING CONFIGURATION
# ============================================

# Email Alerts
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_TO=ops@your-company.com,treasury@your-company.com
ALERT_EMAIL_FROM=alerts@your-domain.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=${VAULT_SMTP_USER}
SMTP_PASSWORD=${VAULT_SMTP_PASSWORD}

# Slack Alerts
ALERT_SLACK_ENABLED=true
ALERT_SLACK_WEBHOOK=${VAULT_SLACK_WEBHOOK}
ALERT_SLACK_CHANNEL=#jpmorgan-alerts

# PagerDuty
PAGERDUTY_ENABLED=true
PAGERDUTY_INTEGRATION_KEY=${VAULT_PAGERDUTY_KEY}

# ============================================
# PAYMENT LIMITS & CONTROLS
# ============================================

# Transaction Limits (in cents)
DEFAULT_TRANSACTION_LIMIT=100000000
DEFAULT_DAILY_LIMIT=1000000000
DEFAULT_MONTHLY_LIMIT=10000000000

# ACH Limits
ACH_SINGLE_TRANSACTION_LIMIT=100000000
ACH_DAILY_LIMIT=500000000
ACH_SAME_DAY_LIMIT=100000000

# Wire Limits
WIRE_SINGLE_TRANSACTION_LIMIT=1000000000
WIRE_DAILY_LIMIT=5000000000
WIRE_INTERNATIONAL_LIMIT=500000000

# RTP Limits
RTP_SINGLE_TRANSACTION_LIMIT=100000000
RTP_DAILY_LIMIT=500000000

# Cutoff Times (ET)
ACH_CUTOFF_TIME=17:00:00
ACH_SAME_DAY_CUTOFF_TIME=14:45:00
WIRE_CUTOFF_TIME=14:00:00
WIRE_INTERNATIONAL_CUTOFF_TIME=12:00:00

# ============================================
# APPROVAL WORKFLOW CONFIGURATION
# ============================================

# Approval Thresholds (in cents)
SINGLE_APPROVAL_THRESHOLD=10000000
DUAL_APPROVAL_THRESHOLD=100000000
MULTI_APPROVAL_THRESHOLD=500000000

# Approval Settings
APPROVAL_EXPIRATION_HOURS=24
APPROVAL_NOTIFICATION_ENABLED=true
APPROVAL_REMINDER_HOURS=12

# ============================================
# FRAUD DETECTION & COMPLIANCE
# ============================================

# Fraud Detection
FRAUD_DETECTION_ENABLED=true
FRAUD_VELOCITY_CHECK_ENABLED=true
FRAUD_DUPLICATE_CHECK_ENABLED=true
FRAUD_ANOMALY_DETECTION_ENABLED=true

# Velocity Limits
VELOCITY_CHECK_WINDOW_HOURS=24
VELOCITY_MAX_TRANSACTIONS=100
VELOCITY_MAX_AMOUNT=10000000000

# Compliance
COMPLIANCE_REPORTING_ENABLED=true
COMPLIANCE_AUDIT_TRAIL_ENABLED=true
COMPLIANCE_DATA_RETENTION_DAYS=2555

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_STORAGE_ACCOUNT=${VAULT_BACKUP_STORAGE}

# ============================================
# PERFORMANCE & SCALING
# ============================================
CLUSTER_MODE=true
CLUSTER_WORKERS=4
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_PROVIDER=redis
REDIS_HOST=prod-jpmorgan-cache.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=${VAULT_REDIS_PASSWORD}
REDIS_TLS=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_ACH_ENABLED=true
FEATURE_WIRE_ENABLED=true
FEATURE_RTP_ENABLED=true
FEATURE_SAME_DAY_ACH_ENABLED=true
FEATURE_INTERNATIONAL_WIRE_ENABLED=true
FEATURE_BATCH_PAYMENTS_ENABLED=true
FEATURE_APPROVAL_WORKFLOW_ENABLED=true
FEATURE_FRAUD_DETECTION_ENABLED=true

# ============================================
# MAINTENANCE MODE
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System maintenance in progress. Please try again later.
MAINTENANCE_ALLOWED_IPS=10.0.1.100,10.0.1.101

# ============================================
# EXTERNAL SERVICES
# ============================================

# Notification Service
NOTIFICATION_SERVICE_URL=https://notifications.your-domain.com
NOTIFICATION_SERVICE_API_KEY=${VAULT_NOTIFICATION_API_KEY}

# Document Storage
DOCUMENT_STORAGE_ENABLED=true
DOCUMENT_STORAGE_PROVIDER=azure_blob
AZURE_STORAGE_ACCOUNT=${VAULT_AZURE_STORAGE_ACCOUNT}
AZURE_STORAGE_KEY=${VAULT_AZURE_STORAGE_KEY}
AZURE_STORAGE_CONTAINER=jpmorgan-documents

# ============================================
# TIMEZONE & LOCALIZATION
# ============================================
TZ=America/New_York
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US

# ============================================
# HEALTH CHECK CONFIGURATION
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_SECRET=${VAULT_SESSION_SECRET}
SESSION_TIMEOUT=3600000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict

# ============================================
# WEBHOOK RETRY CONFIGURATION
# ============================================
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_MS=5000
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=2

# ============================================
# IDEMPOTENCY CONFIGURATION
# ============================================
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_HEADER_NAME=Idempotency-Key

# ============================================
# AUDIT TRAIL CONFIGURATION
# ============================================
AUDIT_TRAIL_ENABLED=true
AUDIT_TRAIL_STORAGE=database
AUDIT_TRAIL_RETENTION_DAYS=2555
AUDIT_TRAIL_INCLUDE_REQUEST_BODY=true
AUDIT_TRAIL_INCLUDE_RESPONSE_BODY=false

# ============================================
# END OF CONFIGURATION
# ============================================
