{
  "dashboard": {
    "title": "JPMorgan Banking Dashboard",
    "tags": ["jpmorgan", "banking", "payments"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total Available Balance",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/balances",
            "jsonPath": "$.data[*].availableBalance"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 10000,
                  "color": "yellow"
                },
                {
                  "value": 50000,
                  "color": "green"
                }
              ]
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["sum"]
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 2,
        "title": "Current Balance",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/balances",
            "jsonPath": "$.data[*].currentBalance"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["sum"]
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 3,
        "title": "Number of Accounts",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/accounts",
            "jsonPath": "$.meta.count"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 4,
        "title": "API Status",
        "type": "stat",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/balances",
            "jsonPath": "$.status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "type": "value",
                "options": {
                  "ok": {
                    "text": "✓ Online",
                    "color": "green"
                  },
                  "error": {
                    "text": "✗ Error",
                    "color": "red"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "orientation": "auto",
          "textMode": "value",
          "colorMode": "background"
        }
      },
      {
        "id": 5,
        "title": "Account Balances by Account",
        "type": "bargauge",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/balances",
            "jsonPath": "$.data[*]"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": {
              "mode": "palette-classic"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "green"
                },
                {
                  "value": 10000,
                  "color": "yellow"
                },
                {
                  "value": 50000,
                  "color": "red"
                }
              ]
            }
          }
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {
                "accountId": 0,
                "availableBalance": 1
              },
              "renameByName": {
                "accountId": "Account",
                "availableBalance": "Balance"
              }
            }
          }
        ]
      },
      {
        "id": 6,
        "title": "Balance Trend",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/balances",
            "jsonPath": "$.data[*]"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto",
              "pointSize": 5
            }
          }
        },
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {
                "asOf": 0,
                "currentBalance": 1,
                "accountId": 2
              },
              "renameByName": {
                "asOf": "Time",
                "currentBalance": "Balance",
                "accountId": "Account"
              }
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Recent Transactions",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/transactions",
            "jsonPath": "$.data[*]"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "amount"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "currencyUSD"
                },
                {
                  "id": "decimals",
                  "value": 2
                },
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "postedAt"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "dateTimeAsIso"
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "sortBy": [
            {
              "displayName": "postedAt",
              "desc": true
            }
          ]
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "id": true,
                "accountId": false
              },
              "indexByName": {
                "postedAt": 0,
                "description": 1,
                "amount": 2,
                "type": 3,
                "currency": 4
              },
              "renameByName": {
                "postedAt": "Date",
                "description": "Description",
                "amount": "Amount",
                "type": "Type",
                "currency": "Currency",
                "accountId": "Account"
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "Account List",
        "type": "table",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 24,
          "h": 6
        },
        "targets": [
          {
            "refId": "A",
            "datasource": "JPMorgan API",
            "url": "/accounts",
            "jsonPath": "$.data[*]"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            }
          }
        },
        "options": {
          "showHeader": true
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "id": true
              },
              "indexByName": {
                "accountName": 0,
                "accountNumber": 1,
                "accountType": 2,
                "currency": 3
              },
              "renameByName": {
                "accountName": "Account Name",
                "accountNumber": "Account Number",
                "accountType": "Type",
                "currency": "Currency"
              }
            }
          }
        ]
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  },
  "overwrite": false
}
