# JPMorgan Financial APIs - Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# ============================================================================
# CORE APPLICATION SETTINGS
# ============================================================================

# Flask Secret Key - Generate a secure random key for production
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=False

# Application Host and Port
HOST=0.0.0.0
PORT=8000

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://jpmorgan_user:secure_password@postgresql:5432/jpmorgan_financial_apis

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis URL for caching and session management
REDIS_URL=redis://redis:6379/0

# Redis Connection Pool Settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Cache TTL (Time To Live) in seconds
CACHE_DEFAULT_TTL=300
CACHE_TELEMETRY_TTL=60

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret Keys
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_REFRESH_SECRET_KEY=your-jwt-refresh-secret-key-change-this

# JWT Token Expiration (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# API Token Configuration
TOKEN_CLIENT_ID=your-client-id
TOKEN_CLIENT_SECRET=your-client-secret
TOKEN_ENDPOINT=https://api.jpmorgan.com/oauth/token

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1

# CORS Settings
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=True

# ============================================================================
# CLOUD STORAGE CONFIGURATION
# ============================================================================

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=jpmorgan-telemetry-data

# Google Cloud Storage Configuration
GCS_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=jpmorgan-telemetry-data
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_CONTAINER_NAME=jpmorgan-telemetry-data

# ============================================================================
# GPU CONFIGURATION
# ============================================================================

# NVIDIA GPU Settings
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8
TF_FORCE_GPU_ALLOW_GROWTH=True

# GPU Acceleration
USE_GPU=True
GPU_DEVICE_ID=0

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus Metrics
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090

# Grafana Configuration
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=your-grafana-api-key

# Application Performance Monitoring
APM_ENABLED=True
APM_SERVICE_NAME=jpmorgan-financial-apis
APM_SERVER_URL=http://apm-server:8200
APM_SECRET_TOKEN=your-apm-secret-token

# Logging Configuration
LOG_FORMAT=json
LOG_FILE=/var/log/jpmorgan/application.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Sentry Error Tracking (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# EXTERNAL API INTEGRATIONS
# ============================================================================

# GitHub MCP Server Configuration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repository-name

# Allow Missing Tokens (for testing)
ALLOW_MISSING_TOKENS=False

# ============================================================================
# MACHINE LEARNING CONFIGURATION
# ============================================================================

# ML Model Settings
ML_MODEL_PATH=/app/models
ML_BATCH_SIZE=32
ML_INFERENCE_TIMEOUT=30

# Anomaly Detection Thresholds
ANOMALY_THRESHOLD=0.95
ANOMALY_WINDOW_SIZE=100

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

# WebSocket Settings
WEBSOCKET_ENABLED=True
WEBSOCKET_PING_INTERVAL=25
WEBSOCKET_PING_TIMEOUT=60
WEBSOCKET_MAX_CONNECTIONS=1000

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Feature Toggles
FEATURE_ML_ENABLED=True
FEATURE_GPU_ACCELERATION=True
FEATURE_CLOUD_STORAGE=True
FEATURE_WEBSOCKET=True
FEATURE_ADVANCED_ANALYTICS=True

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Worker Configuration
WORKERS=4
WORKER_CLASS=gevent
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=120

# Request Timeout
REQUEST_TIMEOUT=60

# Max Request Size (in bytes)
MAX_CONTENT_LENGTH=16777216

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

# SSL Certificate Paths
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key
SSL_CA_CERT_PATH=/etc/ssl/certs/ca-bundle.crt

# Force HTTPS
FORCE_HTTPS=True
HTTPS_REDIRECT=True

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================

# Audit Logging
AUDIT_LOG_ENABLED=True
AUDIT_LOG_PATH=/var/log/jpmorgan/audit.log

# Data Retention Policy (in days)
DATA_RETENTION_DAYS=90
LOG_RETENTION_DAYS=365

# GDPR Compliance
GDPR_ENABLED=True
DATA_ANONYMIZATION=True

# ============================================================================
# KUBERNETES SPECIFIC (if deploying to K8s)
# ============================================================================

# Kubernetes Service Discovery
K8S_NAMESPACE=jpmorgan-financial-apis
K8S_SERVICE_NAME=jpmorgan-api

# Health Check Endpoints
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

# ============================================================================
# ADDITIONAL SETTINGS
# ============================================================================

# Timezone
TZ=UTC

# Application Version
APP_VERSION=1.0.0

# Maintenance Mode
MAINTENANCE_MODE=False

# Debug Mode (should be False in production)
DEBUG=False

# ============================================================================
# NOTES
# ============================================================================
# 
# 1. Never commit this file with actual secrets to version control
# 2. Use a secrets management system (AWS Secrets Manager, HashiCorp Vault, etc.)
# 3. Rotate secrets regularly
# 4. Use strong, randomly generated passwords
# 5. Enable all security features in production
# 6. Monitor and log all access attempts
# 7. Regularly review and update security configurations
#
# ============================================================================
