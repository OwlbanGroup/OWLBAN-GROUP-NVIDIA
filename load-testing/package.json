{
  "name": "jpmorgan-load-testing",
  "version": "1.0.0",
  "description": "Load testing suite for JPMorgan Financial APIs",
  "main": "artillery-config.yml",
  "scripts": {
    "test:load": "artillery run artillery-config.yml",
    "test:smoke": "artillery run --overrides '{\"config\": {\"phases\": [{\"duration\": 30, \"arrivalRate\": 2}]}}' artillery-config.yml",
    "test:stress": "artillery run --overrides '{\"config\": {\"phases\": [{\"duration\": 120, \"arrivalRate\": 100}]}}' artillery-config.yml",
    "test:spike": "artillery run --overrides '{\"config\": {\"phases\": [{\"duration\": 60, \"arrivalRate\": 200}]}}' artillery-config.yml",
    "report:generate": "artillery report report.json"
  },
  "dependencies": {
    "artillery": "^2.0.8",
    "faker": "^6.6.6",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "artillery-plugin-metrics-by-endpoint": "^1.2.0",
    "artillery-plugin-expect": "^1.3.0"
  },
  "keywords": [
    "load-testing",
    "performance",
    "artillery",
    "jpmorgan",
    "api-testing"
  ],
  "author": "JPMorgan Chase",
  "license": "Proprietary"
}
