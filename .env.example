# OWLBAN GROUP - NVIDIA AI API Server configuration
# Copy to ".env" and adjust. Values set in the environment take precedence
# over this file; `main.py` loads .env automatically when present.

# --- API server (HTTP Basic auth) — REQUIRED for api_server.py ---
# A strong random password is generated automatically if this is left blank
# (run `python main.py` and read the console). Set explicitly for production.
API_USERNAME=owlban_admin
API_PASSWORD=change_me_to_a_strong_random_value

# --- Network ---
API_HOST=127.0.0.1      # use 0.0.0.0 to expose to the network
API_PORT=8000

# --- JWT auth (auth_lib.py) — random defaults are generated if unset ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Password policy (auth_lib.py) ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false   # set true to require a special character
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- External services (optional; system degrades gracefully when absent) ---
# Stripe Python SDK + key for real payments. Without these, payments are
# simulated so the platform still runs end-to-end.
#
# STRIPE_API_KEY is the SERVER-side key used by new_products/stripe_integration.py.
# spend_profits() only ever calls stripe.Transfer.create() and
# stripe.PaymentIntent.create().
#
# Best practice (per Stripe's "API keys" guide): for this autonomous backend,
# prefer a RESTRICTED live key (rk_live_) with the MINIMUM scope the code needs:
#   transfer:write        (Transfer.create in spend_profits)
#   payment_intent:write  (PaymentIntent.create in spend_profits)
#   [optionally] balance:read, account:read
# Avoid handing the agent a raw sk_live_ key. Instead: create a restricted key,
# tag it as an agent key, and enable Stripe approval rules so payouts/transfers
# require a human reviewer before they take effect.
#
# Wire it safely — NEVER commit a real key; keep it ONLY in your git-ignored .env:
#   1) Stripe Dashboard -> API keys -> "Create restricted key" (rk_live_) with
#      the scope above.
#   2) Tag as an agent key; enable approval rules for payouts/transfers.
#   3) Paste the rk_live_ value into .env  ->  STRIPE_API_KEY=<rk_live_...>
# Never paste sk_live_/rk_live_ values into chat or source code. The publishable
# key pk_live_ belongs to your FRONT-END Stripe.js client — this API server does
# not consume it.
STRIPE_API_KEY=
# Organization-level keys (sk_org_*) act across multiple Stripe accounts and
# require the target account (acct_...) via the Stripe-Context header. Set this
# ONLY when STRIPE_API_KEY is an sk_org_ key (leave blank for account-level
# sk_/rk_ keys); the integration sets no extra headers in account-key mode.
# See new_products/stripe_integration.py:_configure_org_headers().
STRIPE_ORG_ACCOUNT=

# Google Gemini API key (optional; disabled when unset)
GEMINI_API_KEY=

# PostgreSQL (used by DatabaseManager if available; SQLite is the fallback)
DATABASE_URL=

# Redis (optional session/cache backend; disabled when absent)
REDIS_URL=
