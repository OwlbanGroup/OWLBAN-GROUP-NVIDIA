# OWLBAN GROUP - NVIDIA AI API Server configuration
# Copy to ".env" and adjust. Values set in the environment take precedence
# over this file; `main.py` loads .env automatically when present.

# --- API server (HTTP Basic auth) — REQUIRED for api_server.py ---
# A strong random password is generated automatically if this is left blank
# (run `python main.py` and read the console). Set explicitly for production.
API_USERNAME=owlban_admin
API_PASSWORD=change_me_to_a_strong_random_value

# --- Network ---
API_HOST=127.0.0.1      # use 0.0.0.0 to expose to the network
API_PORT=8000

# --- JWT auth (auth_lib.py) — random defaults are generated if unset ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Password policy (auth_lib.py) ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false   # set true to require a special character
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- External services (optional; system degrades gracefully when absent) ---
# Stripe Python SDK + live key for real payments. Without these, payments are
# simulated so the platform still runs end-to-end.
STRIPE_API_KEY=

# Google Gemini API key (optional; disabled when unset)
GEMINI_API_KEY=

# PostgreSQL (used by DatabaseManager if available; SQLite is the fallback)
DATABASE_URL=

# Redis (optional session/cache backend; disabled when absent)
REDIS_URL=
