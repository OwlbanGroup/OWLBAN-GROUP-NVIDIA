# JPMorgan Financial APIs - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
TESTING=0
SECRET_KEY=your-32-character-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/jpmorgan_financial_apis

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Logging
AUDIT_LOG_ENABLED=true
LOG_LEVEL=INFO

# AI Services
BLACKBOX_API_KEY=your-blackbox-api-key-here
LANGCHAIN_API_KEY=your-langchain-api-key-here

# Payment Processing
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Authentication
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# External APIs (Optional)
APOLLO_API_KEY=your-apollo-api-key-here
GRAFANA_CLOUD_API_KEY=your-grafana-api-key-here
