# JPMorgan Financial APIs - Docker Environment
# Copy to .env and edit secrets

# Dev
ENVIRONMENT=development
SECRET_KEY=change_me_super_secret_key_do_not_use_in_prod
DEBUG=true

# DB (dev defaults used if unset)
TELEMETRY_DB_USER=telemetry_user
TELEMETRY_DB_PASSWORD=telemetry_pass

# Redis
REDIS_PASSWORD=redis_pass

# Services
GITHUB_TOKEN=ghp_your_personal_access_token
STRIPE_SECRET_KEY=sk_test_...
JPMORGAN_API_KEY=your_jpm_key
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# Prod overrides (docker compose --profile prod)
ALLOWED_ORIGINS=https://yourdomain.com
LOG_LEVEL=info

# AI/ML
CUDA_VERSION=12.1
ML_MODEL_PATH=/models/your_model.pt
