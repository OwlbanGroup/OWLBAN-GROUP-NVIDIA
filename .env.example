# JPMorgan Financial APIs - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ==========================================
# FLASK APPLICATION SETTINGS
# ==========================================
FLASK_ENV=production
TESTING=0
FLASK_RUN_PORT=5000
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# ==========================================
# DATABASE SETTINGS
# ==========================================
DATABASE_TYPE=postgresql
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=jpmorgan_financial
DATABASE_USER=jpmorgan_user
DATABASE_PASSWORD=jpmorgan_password_2024
DATABASE_SSL_MODE=require
DATABASE_CONNECTION_POOL_SIZE=10
DATABASE_CONNECTION_POOL_MAX_OVERFLOW=20
DATABASE_CONNECTION_POOL_TIMEOUT=30
DATABASE_CONNECTION_POOL_RECYCLE=3600

# SQLite fallback (for development/testing)
# DATABASE_URL=sqlite:///jpmorgan_api.db

# ==========================================
# REDIS CACHE SETTINGS
# ==========================================
REDIS_URL=redis://redis:6379/0

# ==========================================
# JPMORGAN API CREDENTIALS
# ==========================================
JPMORGAN_ENVIRONMENT=prod
JPMORGAN_MERCHANT_PRODUCTION_URL=https://api.merchant.jpmorgan.com/tsapi/v1
JPMORGAN_MERCHANT_MTLS_PRODUCTION_URL=https://api-mtls.merchant.jpmorgan.com/tsapi/v1
JPMORGAN_MERCHANT_UAT_URL=https://api-pci-uat.jpmorgan.com/tsapi/v1
JPMORGAN_MERCHANT_MTLS_UAT_URL=https://api-mtls-pci-uat.jpmorgan.com/tsapi/v1
JPMORGAN_OPENBANKING_PRODUCTION_URL=https://openbanking.jpmorgan.com/accessapi
JPMORGAN_OPENBANKING_UAT_URL=https://openbankinguat.jpmorgan.com/accessapi
JPMORGAN_APIGATEWAY_PRODUCTION_URL=https://apigateway.jpmorgan.com/accessapi
JPMORGAN_APIGATEWAY_QAF_URL=https://apigatewayqaf.jpmorgan.com/accessapi

# OpenBanking API Credentials
JPMORGAN_OPENBANKING_CLIENT_ID=your-openbanking-client-id
JPMORGAN_OPENBANKING_CLIENT_SECRET=your-openbanking-client-secret
JPMORGAN_OPENBANKING_API_KEY=your-openbanking-api-key

# API Gateway Credentials
JPMORGAN_APIGATEWAY_CLIENT_ID=your-apigateway-client-id
JPMORGAN_APIGATEWAY_CLIENT_SECRET=your-apigateway-client-secret
JPMORGAN_APIGATEWAY_API_KEY=your-apigateway-api-key

# ==========================================
# TOKEN MANAGEMENT SETTINGS
# ==========================================
TOKEN_CLIENT_ID=your-token-client-id
TOKEN_CLIENT_SECRET=your-token-client-secret
TOKEN_URL=https://id.payments.jpmorgan.com/am/oauth2/alpha/access_token
TOKEN_SCOPE=openid profile

# ==========================================
# JWT SETTINGS
# ==========================================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# CORS SETTINGS
# ==========================================
ALLOWED_ORIGINS=https://app.jpmorgan.com,https://dashboard.jpmorgan.com,https://api.jpmorgan.com

# ==========================================
# LOGGING SETTINGS
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=logs/telemetry.log

# ==========================================
# TELEMETRY SETTINGS
# ==========================================
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# ==========================================
# AUDIT LOGGING SETTINGS
# ==========================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_MAX_SIZE=10000000
AUDIT_ALERT_ENABLED=true
AUDIT_FAILED_LOGIN_THRESHOLD=5
AUDIT_RATE_LIMIT_THRESHOLD=100
AUDIT_BRUTE_FORCE_THRESHOLD=10
AUDIT_SUSPICIOUS_IP_THRESHOLD=5
AUDIT_ALERT_NOTIFICATION_METHOD=log
AUDIT_CLEANUP_ENABLED=true
AUDIT_HASH_CHAIN_ENABLED=true

# ==========================================
# GITHUB MCP SERVER SETTINGS (Optional)
# ==========================================
MCP_SERVER_COMMAND=docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token
MCP_SERVER_TOOLSETS=all
MCP_SERVER_HOST=

# ==========================================
# NGC (NVIDIA GPU Cloud) SETTINGS (Optional)
# ==========================================
NGC_API_KEY=your-ngc-api-key
NGC_CLI_PATH=ngc
NGC_REGISTRY_URL=nvcr.io
NGC_ORG=nvidia

# ==========================================
# GPU SETTINGS (Optional)
# ==========================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_FRACTION=0.8

# ==========================================
# APOLLO.IO DATA ENRICHMENT SETTINGS
# ==========================================
APOLLO_API_KEY=your-apollo-api-key
APOLLO_BASE_URL=https://api.apollo.io/v1
APOLLO_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ==========================================
# PROMETHEUS METRICS SETTINGS
# ==========================================
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=8000

# ==========================================
# RATE LIMITING SETTINGS
# ==========================================
RATE_LIMIT_DEFAULT=1000 per day,200 per hour
RATE_LIMIT_STRICT=5 per minute

# ==========================================
# EMAIL/SMTP SETTINGS (for alerts)
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=alerts@jpmorgan-financial.com

# ==========================================
# SLACK/WEBHOOK ALERTS (Optional)
# ==========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
WEBHOOK_URL=https://your-monitoring-service.com/webhook

# ==========================================
# BACKUP SETTINGS
# ==========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/opt/backups

# ==========================================
# MONITORING SETTINGS
# ==========================================
HEALTH_CHECK_INTERVAL=30
METRICS_COLLECTION_INTERVAL=60
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=85
ALERT_THRESHOLD_DISK=90

# ==========================================
# SECURITY SETTINGS
# ==========================================
ENCRYPTION_KEY=your-32-character-encryption-key-here
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8
REQUIRE_2FA=false

# ==========================================
# DEVELOPMENT/DEBUG SETTINGS
# ==========================================
DEBUG=false
DEVELOPMENT_MODE=false
ALLOW_MISSING_TOKENS=false

# ==========================================
# PRODUCTION OVERRIDES
# ==========================================
# These settings are automatically applied when FLASK_ENV=production
# FORCE_HTTPS=true
# SESSION_COOKIE_SECURE=true
# REMEMBER_COOKIE_SECURE=true
# PREFERRED_URL_SCHEME=https
