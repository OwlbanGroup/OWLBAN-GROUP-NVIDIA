# ============================================
# JPMorgan Financial APIs - Production Environment
# ============================================
# Copy this file to .env.production and fill in your actual credentials
# NEVER commit .env.production to version control!

# Environment Selection
JPMORGAN_ENVIRONMENT=production

# ============================================
# OpenBanking API - Production
# ============================================
JPMORGAN_OPENBANKING_PRODUCTION_URL=https://openbanking.jpmorgan.com/accessapi
JPMORGAN_OPENBANKING_CLIENT_ID=your_production_openbanking_client_id_here
JPMORGAN_OPENBANKING_CLIENT_SECRET=your_production_openbanking_client_secret_here
JPMORGAN_OPENBANKING_API_KEY=your_production_openbanking_api_key_here

# ============================================
# API Gateway - Production
# ============================================
JPMORGAN_APIGATEWAY_PRODUCTION_URL=https://apigateway.jpmorgan.com/accessapi
JPMORGAN_APIGATEWAY_CLIENT_ID=your_production_apigateway_client_id_here
JPMORGAN_APIGATEWAY_CLIENT_SECRET=your_production_apigateway_client_secret_here
JPMORGAN_APIGATEWAY_API_KEY=your_production_apigateway_api_key_here

# ============================================
# Legacy JPMorgan API Settings (if needed)
# ============================================
JPMORGAN_BASE_URL=https://api.payments.jpmorgan.com
JPMORGAN_AUTH_URL=https://auth.payments.jpmorgan.com

# AI Accounts Project
JPMORGAN_AI_ACCOUNTS_CLIENT_ID=your_ai_accounts_client_id_here
JPMORGAN_AI_ACCOUNTS_CLIENT_SECRET=your_ai_accounts_client_secret_here
JPMORGAN_AI_ACCOUNTS_API_KEY=your_ai_accounts_api_key_here

# Corporate Login Project
JPMORGAN_CORPORATE_CLIENT_ID=your_corporate_client_id_here
JPMORGAN_CORPORATE_CLIENT_SECRET=your_corporate_client_secret_here
JPMORGAN_CORPORATE_API_KEY=your_corporate_api_key_here

# Payroll Project
JPMORGAN_PAYROLL_CLIENT_ID=your_payroll_client_id_here
JPMORGAN_PAYROLL_CLIENT_SECRET=your_payroll_client_secret_here
JPMORGAN_PAYROLL_API_KEY=your_payroll_api_key_here

# Petty Cash Project
JPMORGAN_PETTY_CASH_CLIENT_ID=your_petty_cash_client_id_here
JPMORGAN_PETTY_CASH_CLIENT_SECRET=your_petty_cash_client_secret_here
JPMORGAN_PETTY_CASH_API_KEY=your_petty_cash_api_key_here

# Owl1 Integration Project
JPMORGAN_OWL1_CLIENT_ID=your_owl1_client_id_here
JPMORGAN_OWL1_CLIENT_SECRET=your_owl1_client_secret_here
JPMORGAN_OWL1_API_KEY=your_owl1_api_key_here

# ============================================
# Application Settings
# ============================================
API_BASE_URL=https://api.jpmorgan.com
API_VERSION=v1
LOG_LEVEL=INFO
LOG_FILE=logs/telemetry.log

# Security
SECRET_KEY=your_production_secret_key_here_minimum_32_characters

# Token Management
TOKEN_CLIENT_ID=your_token_client_id_here
TOKEN_CLIENT_SECRET=your_token_client_secret_here
TOKEN_URL=https://id.payments.jpmorgan.com/am/oauth2/alpha/access_token
TOKEN_SCOPE=openid profile

# Database (Production)
DATABASE_TYPE=postgresql
DATABASE_HOST=your_production_db_host
DATABASE_PORT=5432
DATABASE_NAME=jpmorgan_financial_apis_prod
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_SSL_MODE=require

# Redis (Production)
REDIS_URL=redis://your_production_redis_host:6379/0

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=100

# Flask
FLASK_ENV=production
FLASK_RUN_PORT=5000
TESTING=0

# ============================================
# Security Notes
# ============================================
# 1. Never commit this file with real credentials
# 2. Use strong, unique passwords for production
# 3. Rotate credentials regularly (every 90 days)
# 4. Enable MFA on all JPMorgan accounts
# 5. Monitor API usage for anomalies
# 6. Use separate credentials for each environment
